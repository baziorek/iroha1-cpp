# Shell scripts must keep LF endings on Windows checkouts (core.autocrlf=true),
# otherwise bash fails on CR characters (e.g. vcpkg/build_iroha_deps.sh in CI).
*.sh text eol=lf
# Patches are applied byte-for-byte.
*.patch -text
# Read by bash scripts with head/cat; CR would end up in the vcpkg ref.
vcpkg/VCPKG_* text eol=lf
