diff --git a/scripts/cmake/vcpkg_configure_make.cmake b/scripts/cmake/vcpkg_configure_make.cmake
--- a/scripts/cmake/vcpkg_configure_make.cmake
+++ b/scripts/cmake/vcpkg_configure_make.cmake
@@ -210,7 +210,15 @@
     else()
         set(CFLAGS_${_SUFFIX} "${VCPKG_DETECTED_CMAKE_C_FLAGS_${_SUFFIX}}")
         set(CXXFLAGS_${_SUFFIX} "${VCPKG_DETECTED_CMAKE_CXX_FLAGS_${_SUFFIX}}")
     endif()
+    # Allow a portfile to append extra flags (e.g. -std=...) via
+    # VCPKG_CONFIGURE_MAKE_EXTRA_C_FLAGS / _CXX_FLAGS
+    if(DEFINED VCPKG_CONFIGURE_MAKE_EXTRA_C_FLAGS)
+        set(CFLAGS_${_SUFFIX} "${CFLAGS_${_SUFFIX}} ${VCPKG_CONFIGURE_MAKE_EXTRA_C_FLAGS}")
+    endif()
+    if(DEFINED VCPKG_CONFIGURE_MAKE_EXTRA_CXX_FLAGS)
+        set(CXXFLAGS_${_SUFFIX} "${CXXFLAGS_${_SUFFIX}} ${VCPKG_CONFIGURE_MAKE_EXTRA_CXX_FLAGS}")
+    endif()
     string(REGEX REPLACE " +" " " CPPFLAGS_${_SUFFIX} "${CPPFLAGS_${_SUFFIX}}")
     string(REGEX REPLACE " +" " " CFLAGS_${_SUFFIX} "${CFLAGS_${_SUFFIX}}")
     string(REGEX REPLACE " +" " " CXXFLAGS_${_SUFFIX} "${CXXFLAGS_${_SUFFIX}}")
diff --git a/ports/libpq/portfile.cmake b/ports/libpq/portfile.cmake
--- a/ports/libpq/portfile.cmake
+++ b/ports/libpq/portfile.cmake
@@ -278,6 +278,10 @@
     else()
         list(APPEND BUILD_OPTS --without-readline)
     endif()
+    # gcc-15 defaults to -std=gnu23 where 'bool' is a keyword;
+    # pin an older C dialect so PostgreSQL 12's c.h still compiles
+    set(VCPKG_CONFIGURE_MAKE_EXTRA_C_FLAGS "-std=gnu11")
+    set(VCPKG_CONFIGURE_MAKE_EXTRA_CXX_FLAGS "-std=gnu++11")
     vcpkg_configure_make(
         SOURCE_PATH ${SOURCE_PATH}
         COPY_SOURCE
